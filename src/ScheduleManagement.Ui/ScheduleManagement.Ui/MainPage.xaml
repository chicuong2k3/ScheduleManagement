<Page x:Class="ScheduleManagement.Ui.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ScheduleManagement.Ui"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Foreground="{DynamicResource Theme_TextBrush}" d:DesignWidth="430" d:DesignHeight="932">

    <Grid Background="{DynamicResource Theme_BackgroundBrush}">
        <TextBlock Text="{Binding WelcomeText}" FontSize="23" Margin="32,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel HorizontalAlignment="Left" Margin="10">
            <TextBlock Text="Enter some text below:" FontSize="14"/>
            <TextBox x:Name="MyTextBox1" Text="{Binding WelcomeText, Mode=TwoWay}" Margin="5" Width="395"/>
            <Button Content="Click me" Command="{Binding SomeCommand}"/>
        </StackPanel>
        
    </Grid>
</Page>
