<UserControl x:Class="ScheduleManagement.Ui.Presentation.Controls.AddEventSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

  <!-- Add-Event bottom sheet: Things 3 minimalism on Cupertino sheet chrome.
       Grabber pill, large rounded top corners, generous spacing.
       Host inside a toolkit BottomSheet; commands come from the parent Model (MVUX). -->
  <Grid Background="{ThemeResource CupertinoSecondarySystemGroupedBackgroundBrush}"
        CornerRadius="20,20,0,0"
        Padding="0,0,0,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Grabber -->
    <Border Grid.Row="0"
            Width="36"
            Height="5"
            CornerRadius="3"
            Margin="0,12,0,4"
            HorizontalAlignment="Center"
            Background="{ThemeResource CupertinoSeparatorBrush}" />

    <!-- Sheet title -->
    <TextBlock Grid.Row="1"
               Text="New Event"
               FontSize="20"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Margin="0,14,0,8" />

    <!-- Form -->
    <StackPanel Grid.Row="2"
                Padding="24,8"
                Spacing="16">
      <TextBox Header="Title"
               PlaceholderText="Event name"
               Text="{Binding Title, ElementName=Root, Mode=TwoWay}" />
      <Grid ColumnSpacing="12" ColumnDefinitions="*,*">
        <DatePicker Grid.Column="0" Header="Date" />
        <TimePicker Grid.Column="1" Header="Time" />
      </Grid>
      <TextBlock Text="Color"
                 FontSize="13"
                 Foreground="{ThemeResource CupertinoSecondaryLabelBrush}"
                 Margin="0,4,0,-8" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource CupertinoBlueBrush}" />
        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource CupertinoPurpleBrush}" />
        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource CupertinoGreenBrush}" />
        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource CupertinoOrangeBrush}" />
        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource CupertinoRedBrush}" />
        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource CupertinoTealBrush}" />
      </StackPanel>
    </StackPanel>

    <!-- Actions -->
    <Grid Grid.Row="3"
          Padding="24,8,24,0"
          ColumnSpacing="12"
          ColumnDefinitions="*,*">
      <Button Grid.Column="0"
              Content="Cancel"
              Background="Transparent"
              Foreground="{ThemeResource CupertinoBlueBrush}"
              Command="{Binding CancelCommand, ElementName=Root}" />
      <Button Grid.Column="1"
              Content="Save"
              Command="{Binding SaveCommand, ElementName=Root}" />
    </Grid>
  </Grid>
</UserControl>