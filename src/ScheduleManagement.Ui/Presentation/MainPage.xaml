<Page x:Class="ScheduleManagement.Ui.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ScheduleManagement.Ui.Presentation"
      xmlns:controls="using:ScheduleManagement.Ui.Presentation.Controls"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <utu:DrawerControl IsOpen="{Binding IsSheetOpen, Mode=TwoWay}"
                     OpenDirection="Up">
    <utu:DrawerControl.Content>
      <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <utu:NavigationBar Content="{Binding Title}" />

        <ScrollViewer Grid.Row="1" IsTabStop="True">
          <StackPanel Padding="16" Spacing="12">
            <TextBlock Text="Today"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="4,4,0,8" />

            <!-- Custom component #1: Fantastical-style event card -->
            <controls:EventCard Title="Design review"
                                Subtitle="Product · Room A"
                                StartTime="09:30"
                                EndTime="10:30"
                                AccentBrush="{ThemeResource CupertinoBlueBrush}" />
            <controls:EventCard Title="Team sync"
                                Subtitle="Engineering"
                                StartTime="11:00"
                                EndTime="11:30"
                                AccentBrush="{ThemeResource CupertinoPurpleBrush}" />
            <controls:EventCard Title="Lunch"
                                Subtitle="With Huy"
                                StartTime="12:00"
                                EndTime="13:00"
                                AccentBrush="{ThemeResource CupertinoGreenBrush}" />

            <Button Content="Add Event"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"
                    Command="{Binding ToggleSheet}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </utu:DrawerControl.Content>

    <!-- Custom component #2: Add-Event sheet (grabber + rounded top, Things 3 form) -->
    <utu:DrawerControl.DrawerContent>
      <controls:AddEventSheet SaveCommand="{Binding SaveEvent}"
                              CancelCommand="{Binding CancelEvent}" />
    </utu:DrawerControl.DrawerContent>
  </utu:DrawerControl>
</Page>