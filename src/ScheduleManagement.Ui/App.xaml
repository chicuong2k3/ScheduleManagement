<Application x:Class="ScheduleManagement.Ui.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:uc="using:Uno.Cupertino">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Uno Cupertino (iOS Human Interface Guidelines styling) -->
        <uc:CupertinoColors OverrideSource="ms-appx:///Styles/CupertinoColorsOverride.xaml" />
        <uc:CupertinoFonts />
        <uc:CupertinoResources />
        <!-- Load Uno.UI.Toolkit resources -->
        <ToolkitResources xmlns="using:Uno.Toolkit.UI" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Add resources here -->

    </ResourceDictionary>
  </Application.Resources>

</Application>
